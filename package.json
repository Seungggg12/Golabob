{
  "name": "golabob",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @golabob/api run dev",
    "dev:web": "npm --workspace @golabob/web run dev",
    "dev:mobile": "npm --workspace @golabob/mobile run dev",
    "migrate:api": "npm --workspace @golabob/api run migrate",
    "migrate:status:api": "npm --workspace @golabob/api run migrate:status",
    "build:api": "npm --workspace @golabob/api run build",
    "build:web": "npm --workspace @golabob/web run build",
    "typecheck:mobile": "npm --workspace @golabob/mobile run typecheck",
    "test": "npm --workspace @golabob/api test"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^11.1.27",
    "expo": "~54.0.35",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5"
  }
}
